[Unit]
Description=Weekly front-desk reports (PDF / md / Slack)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
EnvironmentFile=/etc/rec/env
Environment=FRONTREC_CONFIG=__REPO__/config.yaml
WorkingDirectory=__REPO__
ExecStart=__VENV__/bin/python -m frontrec.weekly
ExecStartPost=-__REPO__/scripts/sync-onedrive.sh
